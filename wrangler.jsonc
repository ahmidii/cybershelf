{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cybershelf",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite plugin generates the built asset directory. The Worker also needs
  // its binding to serve moderated catalogue images through their canonical URL.
  "assets": { "binding": "ASSETS" },
  "routes": [
    {
      "pattern": "cybershelf.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://cybershelf.io",
    "MAINTENANCE_ENABLED": "true"
  },
  "triggers": { "crons": ["*/5 * * * *", "2-59/5 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cybershelf-db",
      "database_id": "1aeda0cc-2045-471d-842f-b0423e43b848",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cybershelf-files"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "cybershelf-backups"
    }
  ]
}
